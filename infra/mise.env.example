# Copy to infra/mise.env on the Mise host (never commit it). Non-secret app config only; secrets
# come from infra/.secrets/* via *_FILE (infra/compose.yaml). See docs/runbooks/go-live.md.
PUBLIC_ORIGIN=https://mise.mydomain.com
# The proxy Pi's LAN address as seen by the container (never `true`).
TRUST_PROXY=192.168.1.10
OIDC_ISSUER=https://auth.mydomain.com
# Authelia over the internal mise_oidc network (ADR-012 addendum: public issuer, internal endpoints).
OIDC_INTERNAL_URL=http://authelia:9091
OIDC_CLIENT_ID=mise
OIDC_POST_LOGIN_LOGOUT_URL=https://auth.mydomain.com/logout
LOG_LEVEL=info
