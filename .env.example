# Names only. Never commit values.
NODE_ENV=
HOST=
PORT=
DATABASE_URL=
LOG_LEVEL=
DATABASE_POOL_MAX=
PUBLIC_ORIGIN=      # exact origin, no path, e.g. https://mise.example.com
CSRF_SECRET=        # at least 32 characters; DATABASE_URL and CSRF_SECRET also accept *_FILE
TRUST_PROXY=        # false (default), true (one hop) or a hop count; only behind the proxy