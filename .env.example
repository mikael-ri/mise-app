# Names only. Never commit values.
NODE_ENV=
HOST=
PORT=
DATABASE_URL=
LOG_LEVEL=
DATABASE_POOL_MAX=
PUBLIC_ORIGIN=      # exact origin, no path, e.g. https://mise.example.com
CSRF_SECRET=        # at least 32 characters; DATABASE_URL and CSRF_SECRET also accept *_FILE

# Must be the Authelia origin; the browser is sent there right after login (ADR-003 addendum D4).
SESSION_SECRET=change-me-at-least-32-characters-long   # or SESSION_SECRET_FILE
OIDC_ISSUER=https://auth.example.com
OIDC_INTERNAL_URL=http://authelia:9091                 # optional; defaults to OIDC_ISSUER
OIDC_CLIENT_ID=mise
OIDC_CLIENT_SECRET=change-me                           # or OIDC_CLIENT_SECRET_FILE
OIDC_POST_LOGIN_LOGOUT_URL=https://auth.example.com/logout
TRUST_PROXY=false                                      # production: the proxy's address, e.g. 192.168.1.10