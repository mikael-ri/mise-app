    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Ruskista jauheliha paistokasarissa omassa rasvassaan. Hienonna sipuli, lisää joukkoon ja anna kuullottua."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Sekoita joukkoon tomaattimurskat. Huuhdo tölkit vedellä ja kaada kastikkeeseen. Mausta suolalla, timjamilla, chilitahnalla ja mustapippurilla. Keitä miedolla lämmöllä kannen alla noin 15 minuuttia."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Leikkaa munakoisot pitkittäin noin 1/2 cm:n paksuisiksi viipaleiksi. Voitele ne öljyllä ja paista kuumalla pannulla noin 2 minuuttia/puoli. Huuhdo ja paloittele tuoreet pinaatinlehdet. Käytä pakastepinaatti kohmeisena."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Kokoa moussaka lasagnevuokaan. Levitä pohjalle kerros jauhelihakastiketta. Asettele päälle puolet munakoisoviipaleista ja pinaatista. Ripottele päälle juustoraastetta. Tee toinen kerros samoin. Peitä vuoka jauhelihakastikkeella ja lopulla juustolla."
      },
      {
        "id": "s5",
        "order": 5,
        "text": "Kypsennä 200-asteisen uunin alimmalla tasolla 15–20 minuuttia."
      }
    ]
  },
