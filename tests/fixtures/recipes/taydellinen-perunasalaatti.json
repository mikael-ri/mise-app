    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Keitä perunat suolalla maustetussa vedessä. Kaada vesi pois ja anna jäähtyä."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Kuori ja kuutioi perunat. Kuutioi suolakurkut ja kuorittu omena. Hienonna kevätsipuli. Valuta kaprikset. Pane salaattiainekset kulhoon."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Sekoita kastikkeen ainekset. Sekoita kastike kahdella lusikalla nostellen salaatin joukkoon. Kaada valmis perunasalaatti tarjoilukulhoon. Anna maustua jääkaapissa ennen tarjoamista. Hienonna pinnalle persiljaa tai ruohosipulia."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Kuumenna nakit pannulla paistamalla tai höyryttämällä. Tarjoa nakit perunasalaatin kanssa."
      }
    ]
