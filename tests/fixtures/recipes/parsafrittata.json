    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Laita uuni lämpiämään 170 asteeseen."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Laita kattilallinen vettä kiehumaan. Mausta se hyvin suolalla."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Laita parsat kiehuvaan veteen ja anna olla ihan pienen hetken, max. kolme minuuttia."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Ota kattila pois liedeltä ja kaada kuuma vesi pois, laske nopeasti kattilaan jääkylmää vettä, että parsat lakkaavat kypsymästä."
      },
      {
        "id": "s5",
        "order": 5,
        "text": "Silppua sipuli ja kuullota se kevyesti rypsiöljyssä valurautapannussa."
      },
      {
        "id": "s6",
        "order": 6,
        "text": "Anna paistinpannun jäähtyä sen aikaa kun vatkaat munat kulhossa. Mausta suolalla ja mustapippurilla."
      },
      {
        "id": "s7",
        "order": 7,
        "text": "Kaada munamassa paistinpannuun ja asettele esikeitetyy parsat pannuun. Lisää ricotta-juusto nokareina pannulle."
      },
      {
        "id": "s8",
        "order": 8,
        "text": "Nosta pannu uuniin ja kypsennä noin 20 minuuttia. Silppua päälle tuoreet yritit ja tarjoile."
      }
    ]
  },
