    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Kuumenna uuni 225 asteeseen. Ruskista jauheliha tilkassa öljyä paistinpannulla. Mausta pizzamausteella ja suolalla."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Huuhtele kukkakaali. Leikkaa se noin 1 cm:n viipaleiksi. Levitä ne ja irronneet palat leivinpaperille uunipellille."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Mittaa pesto kulhoon. Sekoita siihen 1 rkl öljyä. Sivele seos kukkakaalien pinnalle. Levitä jauheliha päälle. Huuhtele ja puolita tomaatit. Levitä ne jauhelihan päälle. Ripottele juustoraaste pinnalle."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Kypsennä uunissa 12–15 minuuttia, kunnes juusto sulaa ja ruskistuu hieman. Kukkakaalit saavat jäädä napakoiksi."
      }
    ]
