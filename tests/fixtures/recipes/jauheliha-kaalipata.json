    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Ota jauheliha huoneenlämpöön noin puoli tuntia ennen ruoanvalmistusta."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Huuhtele kaali ja suikaloi se. Kuori ja viipaloi porkkanat."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Kuumenna vesi reilun kokoisessa kattilassa. Lisää lihaliemikuutiot, kaali, porkkanat sekä riisi. Anna kiehua, sekoita välillä. Veden määrä voi aluksi näyttää niukalta. Kaalista irtoaa kuitenkin nestettä kypsymisen aikana. Lisää hieman vettä tarvittaessa."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Hienonna sipuli."
      },
      {
        "id": "s5",
        "order": 5,
        "text": "Paista jauheliha ja sipuli öljyssä paistinpannulla. Lisää ne kattilaan."
      },
      {
        "id": "s6",
        "order": 6,
        "text": "Mausta kaalipata siirapilla, tomaattisoseella, soijakastikkeella, meiramilla ja valkopippurilla."
      },
      {
        "id": "s7",
        "order": 7,
        "text": "Anna hautua kannen alla hiljalleen kiehuen vähintään 30 minuutin (jopa tunnin) ajan, kunnes riisi on kypsää ja kaali pehmeää. Sekoita välillä pohjaa myöten kypsymisen aikana."
      }
    ]
  },
