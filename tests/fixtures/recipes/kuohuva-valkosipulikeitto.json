    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Kuori valkosipulit (kuorittuna 150 g). Kuori salottisipulit ja leikkaa ne puoliksi. Siirrä sipulit uunivuokaan. Lisää pähkinät, timjami, öljy, vaahterasiirappi, suola ja mustapippuri. Sekoita hieman. Paahda 200-asteisessa uunissa noin 35– 45 minuuttia."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Lusikoi keiton ainekset puhtaaseen lasipurkkiin. Koristele tuoreella timjamilla halutessasi ja sulje purkki."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Koristele purkki nauhalla ja kiinnitä siihen kortti alla olevan ohjetekstin kera. Anna lahjaksi kuohuviinipullon kanssa."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Vesi ja kuohuviini lisätään keiton valmistusvaiheessa:"
      },
      {
        "id": "s5",
        "order": 5,
        "text": "Kiehauta 4 dl vettä kattilassa ja lisää purkin sisältö. Anna kiehua 1–2 minuuttia."
      },
      {
        "id": "s6",
        "order": 6,
        "text": "Soseuta keitto sauvasekoittimella."
      },
      {
        "id": "s7",
        "order": 7,
        "text": "Lisää kuohuviini ja tarjoa keitto heti!"
      }
    ]
  },
