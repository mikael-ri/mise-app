      {
        "id": "s1",
        "order": 1,
        "text": "Kaada peruna-sipulisekoitus ja kasvissuikaleet laakeaan voideltuun vuokaan."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Hienonna valkosipulinkynsi. Lisää valkosipuli ja mausteet tasaisesti kasvisten joukkoon."
