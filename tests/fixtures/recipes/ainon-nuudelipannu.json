    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Pilko porkkanat esimerkiksi kolmeen osaan ja keitä ne. Aja teho- tai sauvasekoittimella keitetyt porkkanat, kasvisfondit ja kookosmaito tasaiseksi kastikkeeksi."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Paista sipulit ja kikherneet, mausta pussimausteilla ja valkosipulimurskalla."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Keitä ja valuta nuudelit. Sekoita pannulla yhteen sipuli-kikhernepaistos, nuudelit, kastike ja sriracha."
