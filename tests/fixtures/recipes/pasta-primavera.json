    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Leikkaa kesäkurpitsa pitkittäin puoliksi ja sitten vielä puoliksi. Viipaloi ohuiksi paloiksi. Leikkaa tai napsauta parsan puiseva kanta irti. Paloittele parsat 3–4 osaan."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Keitä pasta pakkauksen ohjeen mukaan reilulla suolalla maustetussa vedessä (2 tl suolaa/2 l vettä)."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Kuullota kesäkurpitsaa ja parsaa öljyssä (1 rkl) pannulla. Lisää joukkoon valkosipuli ja herneet. Paista muutaman minuutin ajan. Lisää loppuvaiheessa kevätsipulit. Mausta suolalla ja pippurilla."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Valuta pasta, ota keitinvettä talteen ja kaada pasta takaisin kattilaan. Lisää pastaan oliiviöljyä. Sekoita joukkoon kasvikset, sitruunanmehu ja -kuori, puolet juustosta sekä keitinvesi. Viimeistele mintulla. Tarjoa loppu juustoraaste pastan kanssa."
      }
    ]
