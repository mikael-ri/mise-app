    "instructions": [
      {
        "id": "s1",
        "order": 1,
        "text": "Raasta punajuuret karkeaksi raasteeksi. Kaada voideltuun uunivuokaan."
      },
      {
        "id": "s2",
        "order": 2,
        "text": "Hienonna keltasipuli ja valkosipulinkynnet. Freesaa sipulit pehmeäksi oliiviöljyssä. Lisää joukkoon riisi ja kuullota hetki. Lisää vehnäjauho ja kypsennä vielä hetki."
      },
      {
        "id": "s3",
        "order": 3,
        "text": "Raasta kasvisliemikuutio veden joukkoon ja lisää pannulle. Sekoita tasaiseksi. Lisää ananasmurska ja 50 g parmesaania. Säästä 25 g parmesaania vuoan päälle. Kaada kastike uunivuokaan ja sekoita hyvin punajuuriraasteen kanssa sekaisin."
      },
      {
        "id": "s4",
        "order": 4,
        "text": "Paista punajuurivuokaa 180 asteisessa uunissa folion alla noin 1 h 20 min, kunnes punajuuri on pehmeää. Poista folio ja lisää pinnalle loppu 25 g parmesaaniraastetta ja voinokareita. Paista vuokaa vielä 10 minuuttia, kunnes parmesaani on sulanut."
      }
    ]
  },
