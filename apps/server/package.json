{
  "name": "@mise/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "cli:provision-household": "tsx src/cli/provision-household.ts",
    "cli:provision-user": "tsx src/cli/provision-user.ts",
    "cli:revoke-sessions": "tsx src/cli/revoke-sessions.ts",
    "cli:export-recipes": "tsx src/cli/export-recipes.ts",
    "cli:load-recipes": "tsx src/cli/load-recipes.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@mise/contracts": "workspace:*",
    "@mise/domain": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
