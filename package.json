{
  "name": "mise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm -r --parallel --filter @mise/server --filter @mise/web dev",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @mise/database db:generate",
    "db:migrate": "pnpm --filter @mise/database db:migrate",
    "db:seed": "pnpm --filter @mise/server cli:load-recipes ../../tests/fixtures/recipes"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
